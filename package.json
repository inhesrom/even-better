{
  "name": "even-better",
  "version": "0.1.0",
  "description": "Use mirrored or process-owned coding agents from Even Realities G2 glasses",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "even-better": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.12.4",
  "license": "MIT",
  "author": "pawaca",
  "repository": {
    "type": "git",
    "url": "https://github.com/pawaca/even-better"
  },
  "keywords": [
    "even-realities",
    "g2-glasses",
    "ar-glasses",
    "claude-code",
    "codex",
    "grok",
    "agent-client-protocol",
    "coding-agent",
    "terminal",
    "sse",
    "herdr",
    "cmux"
  ],
  "scripts": {
    "start": "tsx src/cli.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit false --outDir dist --rootDir src",
    "prepack": "npm run build",
    "check": "tsc --noEmit",
    "test": "tsx --test scripts/test-*.ts",
    "test:app-grok": "tsx --test scripts/test-grok-server.ts",
    "test:app-owned": "tsx --test scripts/test-owned-server.ts",
    "smoke:grok": "tsx tools/smoke-grok-acp.ts",
    "smoke:claude": "tsx tools/smoke-owned-agent.ts claude",
    "smoke:codex": "tsx tools/smoke-owned-agent.ts codex"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.218",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "qrcode-terminal": "^0.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
